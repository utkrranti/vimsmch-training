generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Course {
  id                String   @id @default(cuid()) @map("_id")
  slug              String   @unique
  title             String
  shortDesc         String
  fullDesc          String
  nsqf              Int
  durationMonths    Int
  durationHours     Int
  fees              Int
  feeBreakdown      Json
  seats             Int
  eligibility       String
  ageLimit          String
  certBy            String
  assessmentScheme  String
  creditEquivalence String
  objectives        Json?
  highlights        Json?
  syllabus          Json
  clinicalPostings  Json?
  outcomes          Json
  tags              Json
  category          String
  batchMonths       Json
  isActive          Boolean  @default(true)
  imageUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  inquiries    Inquiry[]
  enrollments  Enrollment[]
  admissionApplications AdmissionApplication[]
  batches      Batch[]
  galleryItems GalleryItem[]
  placements   Placement[]

  @@map("courses")
}

model Inquiry {
  id        String        @id @default(cuid()) @map("_id")
  name      String
  email     String?
  phone     String
  message   String?
  courseId  String?
  course    Course?       @relation(fields: [courseId], references: [id])
  status    String        @default("PENDING")
  ipAddress String?
  createdAt DateTime      @default(now())

  @@map("inquiries")
}

model Enrollment {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  email     String
  phone     String
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  batchId   String?
  batch     Batch?   @relation(fields: [batchId], references: [id])
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  certificate Certificate?

  @@map("enrollments")
}

model Batch {
  id        String   @id @default(cuid()) @map("_id")
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  label     String
  startDate DateTime
  endDate   DateTime
  seats     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  enrollments Enrollment[]
  admissionApplications AdmissionApplication[]

  @@map("batches")
}

model AdmissionApplication {
  id                String   @id @default(cuid()) @map("_id")
  applicationNo     String   @unique
  accessToken       String   @unique
  name              String
  email             String?
  phone             String
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id])
  batchId           String?
  batch              Batch?   @relation(fields: [batchId], references: [id])
  dateOfBirth       DateTime?
  placeOfBirth      String?
  gender            String?
  nationality       String?
  domicile          String?
  bloodGroup        String?
  aadhaarNumber     String?
  addressLine       String?
  city              String?
  district          String?
  state             String?
  pinCode           String?
  residencePhone    String?
  permanentAddressLine String?
  permanentCity     String?
  permanentDistrict String?
  permanentState    String?
  permanentPinCode  String?
  permanentResidencePhone String?
  permanentSameAsPresent Boolean @default(false)
  guardianName      String?
  guardianRelation  String?
  guardianPhone     String?
  emergencyPhone    String?
  fatherName        String?
  fatherAge         Int?
  fatherOccupation  String?
  fatherPhone       String?
  fatherEmail       String?
  motherName        String?
  motherAge         Int?
  motherPhone       String?
  motherEmail       String?
  board             String?
  schoolName        String?
  passingYear       Int?
  seatNumber        String?
  sscMarksObtained  Float?
  sscMaximumMarks   Float?
  percentage        Float?
  sscResultType     String?  @default("MARKS")
  sscSubjects       Json?
  hscApplicable     Boolean  @default(false)
  hscBoard          String?
  hscSchoolName     String?
  hscPassingYear    Int?
  hscMarksObtained  Float?
  hscMaximumMarks   Float?
  hscPercentage     Float?
  hscResultType     String?  @default("MARKS")
  hscSubjects       Json?
  category          String?
  scienceConfirmed  Boolean  @default(false)
  currentStep       Int      @default(1)
  completionPercent Int      @default(15)
  status            String   @default("DRAFT")
  callbackStatus    String   @default("NEW_LEAD")
  assignedTo        String?
  nextCallbackAt    DateTime?
  lastContactedAt   DateTime?
  lastActivityAt    DateTime @default(now())
  contactConsent    Boolean  @default(false)
  declarationAccepted Boolean @default(false)
  paymentStatus     String   @default("NOT_STARTED")
  paymentAmount     Int?
  paymentTxnRef     String?
  paymentDate       DateTime?
  paymentProofUrl   String?
  ipAddress         String?
  submittedAt       DateTime?
  enrollmentId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  documents AdmissionDocument[]
  followUps AdmissionFollowUp[]

  @@index([status])
  @@index([callbackStatus])
  @@index([phone])
  @@map("admission_applications")
}

model AdmissionDocument {
  id            String   @id @default(cuid()) @map("_id")
  applicationId String
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String
  label         String
  fileUrl       String
  fileName      String
  status        String   @default("PENDING")
  adminRemark   String?
  aiStatus      String?
  aiScore       Int?
  aiVisibilityScore Int?
  aiAuthenticity String?
  aiSummary     String?
  aiIssues      String[] @default([])
  aiCheckedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([applicationId, type])
  @@map("admission_documents")
}

model AdmissionFollowUp {
  id             String   @id @default(cuid()) @map("_id")
  applicationId  String
  application    AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  outcome        String
  note           String?
  nextCallbackAt DateTime?
  createdBy      String
  createdAt      DateTime @default(now())

  @@index([applicationId])
  @@map("admission_follow_ups")
}

model GalleryItem {
  id        String   @id @default(cuid()) @map("_id")
  imageUrl  String
  caption   String?
  category  String   @default("campus") // campus | hospital | laboratories | clinical-training | events | convocation | guest-lectures | students
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id])
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("gallery_items")
}

model Announcement {
  id            String   @id @default(cuid()) @map("_id")
  title         String
  body          String
  attachmentUrl String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@map("announcements")
}

model FaqItem {
  id        String   @id @default(cuid()) @map("_id")
  question  String
  answer    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("faq_items")
}

model Placement {
  id           String   @id @default(cuid()) @map("_id")
  studentName  String
  employerName String?
  courseId     String?
  course       Course?  @relation(fields: [courseId], references: [id])
  quote        String?
  batchYear    String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("placements")
}

model Faculty {
  id             String   @id @default(cuid()) @map("_id")
  name           String
  designation    String
  qualification  String?
  experience     String?
  specialization String?
  department     String?
  bio            String?
  photoUrl       String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  @@map("faculty")
}

model Certificate {
  id            String     @id @default(cuid()) @map("_id")
  certificateNo String     @unique
  enrollmentId  String     @unique
  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id])
  studentName   String
  courseName    String
  issuedAt      DateTime   @default(now())

  @@map("certificates")
}

model AdminUser {
  id        String   @id @default(cuid()) @map("_id")
  email     String   @unique
  password  String
  name      String
  role      String   @default("EDITOR")
  createdAt DateTime @default(now())

  @@map("admin_users")
}

model Setting {
  id        String   @id @default(cuid()) @map("_id")
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}
